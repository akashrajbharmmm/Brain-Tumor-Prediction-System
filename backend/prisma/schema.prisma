generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        Int          @id @default(autoincrement())
  name      String
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())

  predictions Prediction[]
}

model Prediction {
  id          Int      @id @default(autoincrement())
  userId      Int
  imagePath   String
  prediction  String
  tumorType   String?
  confidence  Float
  heatmapPath String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}